{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_CONNECTION_STRING"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_JWT_SECRET_MIN_32_CHARS",
    "Issuer": "CineVerseApi",
    "Audience": "CineVerseClient",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationMinutes": 10080
  },
  "GoogleAuth": {
    "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID"
  },
  "Seed": {
    "AdminEmail": "admin@example.local",
    "AdminPassword": "REPLACE_WITH_ADMIN_PASSWORD",
    "AdminFullName": "Admin"
  },
  "Email": {
    "SendEmails": true,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "UserName": "REPLACE_WITH_EMAIL",
    "Password": "REPLACE_WITH_EMAIL_APP_PASSWORD",
    "FromEmail": "REPLACE_WITH_EMAIL",
    "FromName": "CineVerse",
    "ConfirmationBaseUrl": "https://localhost:3000"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "REPLACE_WITH_MINIO_ACCESS_KEY",
    "SecretKey": "REPLACE_WITH_MINIO_SECRET_KEY",
    "Bucket": "posters",
    "UseSSL": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "Application": "CineVerse.API"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Tmdb": {
    "BaseUrl": "https://api.themoviedb.org/3/",
    "ReadAccessToken": "REPLACE_WITH_TMDB_READ_ACCESS_TOKEN",
    "ImageBaseUrl": "https://image.tmdb.org/t/p/original",
    "Language": "en-US",
    "Region": "US"
  },
  "Stripe": {
    "SecretKey": "REPLACE_WITH_STRIPE_SECRET_KEY",
    "PublishableKey": "REPLACE_WITH_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "REPLACE_WITH_STRIPE_WEBHOOK_SECRET"
  },
  "YouTube": {
    "ApiKey": "REPLACE_WITH_YOUTUBE_API_KEY",
    "BaseUrl": "https://www.googleapis.com/youtube/v3/",
    "MaxResults": 12
  },
  "Vip": {
    "MonthlyPriceAzn": 9.99
  },
  "AllowedHosts": "*"
}
